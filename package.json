{
  "name": "pokemon-card-bot",
  "version": "0.1.0",
  "description": "Discord bot that shows Pokémon TCG cards from a slash command or an inline [[card]] mention",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "preview": "tsx scripts/preview.ts",
    "avatar": "tsx scripts/set-avatar.ts",
    "register": "tsx src/discord/register.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "rename": "tsx scripts/rename.ts",
    "index:sets": "tsx scripts/build-set-index.ts",
    "index:text": "tsx scripts/build-text-index.ts"
  },
  "dependencies": {
    "@fawazahmed0/currency-api": "2026.10.28",
    "discord.js": "^14.27.0",
    "pokemon-tcg-pocket-cards": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
