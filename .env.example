# Required. Developer portal: Bot, then Token.
DISCORD_TOKEN=
# Required. Developer portal: General Information, then Application ID.
DISCORD_CLIENT_ID=
# Optional. A server id registers the slash commands there at once instead of globally.
DISCORD_GUILD_ID=
# Reply to [[card]] mentions and @bot search. Needs the Message Content intent.
# This is the deployment-wide switch and the default for servers that have not chosen.
MENTION_ENABLED=true
# Optional. Format pasted decklists, including the Standard legality check and a price.
# This is the deployment-wide default; each server can turn it on or off with /settings.
DECKLIST_ENABLED=false
# Seconds before a member gets another reply once a burst of three is spent. 0 turns the throttle off.
# This is the deployment-wide default; each server can set its own with /settings.
MENTION_COOLDOWN_SECONDS=30
# Requests the bot may have open to the card service at once. Raise only if the service allows it.
UPSTREAM_CONCURRENCY=8
# Requests allowed to wait for a free slot. Beyond this the bot answers that it is busy.
UPSTREAM_QUEUE_LIMIT=32
# Milliseconds a request may wait for a slot before it is refused.
UPSTREAM_QUEUE_WAIT_MS=5000
# Lookups one member may spend at once before they are asked to wait.
MEMBER_LOOKUP_BURST=5
# Seconds to refill one member lookup.
MEMBER_LOOKUP_REFILL_SECONDS=2
# Footer credit on every embed. Leave unset for "Card data from TCGdex".
# ATTRIBUTION=
# Optional. Discord emoji markup by energy type, for example {"Fighting":"<:fighting:123>"}. Upload the icons as application emoji first.
# ENERGY_EMOJI=
# Optional. Directory for the invocation log: the triggering message and the bot's reply,
# no user ids, deleted after at most 60 days. Leave unset to keep the memory-only behaviour.
# INVOCATION_LOG_DIR=
# Days an invocation log entry may live before deletion. Defaults to 60.
# INVOCATION_LOG_RETENTION_DAYS=60
# Optional. Directory for the per-server settings database (settings.db), for example ./data.
# The data directory is gitignored. Without it, server settings live only in memory
# and reset on restart.
# DATA_DIR=
